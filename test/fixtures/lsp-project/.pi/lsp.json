{
  "servers": {
    "typescript": {
      "include": [
        "**/*.{ts,tsx,js,jsx,mjs,cjs,mts,cts}"
      ],
      "bin": "typescript-language-server",
      "args": [
        "--stdio"
      ],
      "languageIdByExtension": {
        ".ts": "typescript",
        ".tsx": "typescriptreact"
      }
    }
  }
}
