{
  "servers": {
    "typescript": {
      "include": ["**/*.{ts,tsx,js,jsx,mjs,cjs,mts,cts}"],
      "rootMarkers": ["pnpm-lock.yaml", "package-lock.json"],
      "bin": "vtsls",
      "args": ["--stdio"],
      "cwd": "{root}",
      "languageIdByExtension": {
        ".ts": "typescript",
        ".tsx": "typescriptreact"
      }
    }
  }
}
