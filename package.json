{
  "name": "@trim21/personal-pi-extensions",
  "version": "0.0.0",
  "type": "module",
  "description": "Custom pi coding-agent extensions: bwrap sandbox, workspace guard, opencode edit, and more",
  "keywords": [
    "pi-package"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/trim21/pi-extensions"
  },
  "files": [
    "src",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "check": "tsc --noEmit && prettier --check .",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "prepare": "husky"
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^0.80.10",
    "@earendil-works/pi-coding-agent": "^0.80.10",
    "@eslint/js": "10.0.1",
    "@types/node": "^24.13.3",
    "@typescript-eslint/utils": "8.67.0",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-erasable-syntax-only": "0.4.2",
    "eslint-plugin-promise": "7.3.0",
    "eslint-plugin-simple-import-sort": "14.0.0",
    "eslint-plugin-tsdoc": "0.5.2",
    "eslint-plugin-unicorn": "73.0.0",
    "eslint-plugin-unused-imports": "4.4.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "typebox": "1.3.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0",
    "vitest": "^4.1.10"
  },
  "pi": {
    "extensions": [
      "src/vision-agent.ts",
      "src/bwrap/index.ts",
      "src/workspace-guard.ts",
      "src/opencode-edit.ts",
      "src/opencode-read.ts",
      "src/opencode-write.ts",
      "src/bash-default-timeout.ts",
      "src/gh-readonly.ts",
      "src/spawn-agent.ts",
      "src/opencode-todo.ts",
      "src/question.ts"
    ]
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yaml,yml}": [
      "prettier --write"
    ]
  },
  "packageManager": "pnpm@11.21.0"
}
