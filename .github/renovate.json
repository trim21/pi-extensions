{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["local>trim21/renovate-config", "local>trim21/renovate-config:monthly"],
  "labels": ["dependencies", "ci:auto-merge"],
  "rebaseWhen": "conflicted",
  "packageRules": [
    {
      "matchPackageNames": ["@earendil-works/pi-ai", "@earendil-works/pi-coding-agent", "typebox"],
      "enabled": false
    },
    {
      "matchPackageNames": ["@cortexkit/aft-bridge", "@cortexkit/aft-linux-x64"],
      "groupName": "@cortexkit/aft",
      "groupSlug": "cortexkit-aft"
    },
    {
      "matchPackageNames": ["pnpm"],
      "groupName": "pnpm"
    }
  ]
}
